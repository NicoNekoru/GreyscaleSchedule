# Generated builds, installers, and local tool state.
.DS_Store
.build/
.swiftpm/
/outputs/
**/xcuserdata/
*.xcuserstate

# Historical builds, backups, and machine-specific diagnostics stay local.
/archive/*
!/archive/README.md
/work/

# Signing credentials must remain local.
*.key
*.pem
*.p12
*.pfx
*.keychain
*.keychain-db
*.mobileprovision
*.provisionprofile
